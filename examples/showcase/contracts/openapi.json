{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InternalServerProblem": {
        "additionalProperties": true,
        "description": "RFC 9457 Problem Details with a stable application code.",
        "properties": {
          "code": {
            "const": "internal_server_error",
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "format": "uri-reference",
            "type": "string"
          },
          "status": {
            "const": 500,
            "type": "integer"
          },
          "title": {
            "const": "Internal Server Error",
            "type": "string"
          },
          "type": {
            "const": "https://api.example.test/problems/internal_server_error",
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "InternalServerProblem",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": true,
        "description": "RFC 9457 Problem Details with a stable application code.",
        "properties": {
          "code": {
            "pattern": "^[a-z][a-z0-9_]{2,}$",
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "format": "uri-reference",
            "type": "string"
          },
          "status": {
            "maximum": 599,
            "minimum": 100,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "Product": {
        "properties": {
          "available": {
            "title": "Available",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "available"
        ],
        "title": "Product",
        "type": "object"
      },
      "ProductNotFoundProblem": {
        "additionalProperties": true,
        "description": "RFC 9457 Problem Details with a stable application code.",
        "properties": {
          "code": {
            "const": "product_not_found",
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "format": "uri-reference",
            "type": "string"
          },
          "status": {
            "const": 404,
            "type": "integer"
          },
          "title": {
            "const": "Product not found",
            "type": "string"
          },
          "type": {
            "const": "https://api.example.test/problems/product_not_found",
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "ProductNotFoundProblem",
        "type": "object"
      },
      "ProductUnavailableProblem": {
        "additionalProperties": true,
        "description": "RFC 9457 Problem Details with a stable application code.",
        "properties": {
          "available": {
            "title": "Available",
            "type": "integer"
          },
          "code": {
            "const": "product_unavailable",
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "format": "uri-reference",
            "type": "string"
          },
          "product_id": {
            "title": "Product Id",
            "type": "string"
          },
          "status": {
            "const": 409,
            "type": "integer"
          },
          "title": {
            "const": "Product unavailable",
            "type": "string"
          },
          "type": {
            "const": "https://api.example.test/problems/product_unavailable",
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "product_id",
          "available"
        ],
        "title": "ProductUnavailableProblem",
        "type": "object"
      },
      "RequestValidationProblem": {
        "additionalProperties": true,
        "description": "RFC 9457 Problem Details with a stable application code.",
        "properties": {
          "code": {
            "const": "request_validation_error",
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                },
                "in": {
                  "enum": [
                    "path",
                    "query",
                    "header",
                    "cookie"
                  ],
                  "type": "string"
                },
                "parameter": {
                  "type": "string"
                },
                "pointer": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "detail"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "instance": {
            "format": "uri-reference",
            "type": "string"
          },
          "status": {
            "const": 422,
            "type": "integer"
          },
          "title": {
            "const": "Request validation failed",
            "type": "string"
          },
          "type": {
            "const": "https://api.example.test/problems/request_validation_error",
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "errors"
        ],
        "title": "RequestValidationProblem",
        "type": "object"
      },
      "Reservation": {
        "properties": {
          "quantity": {
            "exclusiveMinimum": 0.0,
            "maximum": 10.0,
            "title": "Quantity",
            "type": "integer"
          }
        },
        "required": [
          "quantity"
        ],
        "title": "Reservation",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Feature composition with RFC 9457 Problem Details.",
    "title": "fastapi-canon showcase",
    "version": "0.1.0"
  },
  "openapi": "3.2.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Get Health",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerProblem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Health",
        "tags": [
          "status"
        ]
      }
    },
    "/products/{product_id}": {
      "get": {
        "operationId": "get_product",
        "parameters": [
          {
            "in": "path",
            "name": "product_id",
            "required": true,
            "schema": {
              "title": "Product Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductNotFoundProblem"
                }
              }
            },
            "description": "The requested product identifier is unknown."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationProblem"
                }
              }
            },
            "description": "Request validation failed"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerProblem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Get Product",
        "tags": [
          "catalog"
        ]
      }
    },
    "/products/{product_id}/reservations": {
      "post": {
        "operationId": "reserve_product",
        "parameters": [
          {
            "in": "path",
            "name": "product_id",
            "required": true,
            "schema": {
              "title": "Product Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Reservation"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductNotFoundProblem"
                }
              }
            },
            "description": "The requested product identifier is unknown."
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductUnavailableProblem"
                }
              }
            },
            "description": "The product exists, but not enough units are in stock."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationProblem"
                }
              }
            },
            "description": "Request validation failed"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerProblem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Reserve Product",
        "tags": [
          "catalog"
        ]
      }
    }
  }
}
