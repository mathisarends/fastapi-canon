{% macro param_signature(call, receiver) %}{% if not call.params and not call.accepts_extra_params %}{{ receiver }}{% else %}
        {{ receiver }},
{% if call.accepts_extra_params %}        /,
{% endif %}{% if call.params %}        *,
{% for parameter in call.params %}        {{ parameter.name | identifier }}: {{ parameter | parameter_annotation(call.params_optional) }},
{% endfor %}{% endif %}{% if call.accepts_extra_params %}        **_extra: object,
{% endif %}    {% endif %}{% endmacro %}

{% macro params_body(call, names) %}{% if call.params_model is not none %}{% set values = "_values" if "values" in names else "values" %}        {{ values }}: dict[str, object] = {{ "_extra" if call.accepts_extra_params else "{}" }}
{% for parameter in call.params %}{% if parameter.required and not call.params_optional %}        {{ values }}[{{ parameter.name | literal }}] = {{ parameter.name | identifier }}
{% else %}        if {{ parameter.name | identifier }} is not UNSET:
            {{ values }}[{{ parameter.name | literal }}] = {{ parameter.name | identifier }}
{% endif %}{% endfor %}        params = {{ call.params_model | schema_name }}.model_validate({{ values }}){% if call.params_optional %} if {{ values }} else None{% endif %}
{% endif %}{% endmacro %}

{% macro operation(route) %}{% set names = route.params | map(attribute="name") | map("identifier") | list %}{% set receiver = "_self" if "self" in names or route.accepts_extra_params else "self" %}    async def {{ route.operation_name | identifier }}({{ param_signature(route, receiver) }}) -> {{ route.result | annotation }}:
{% set description = route.summary or route.description %}{% if description %}        """{{ description | docstring }}"""
{% endif %}{{ params_body(route, names) }}        {{ "await" if route.result | null_type else "return await" }} {{ receiver }}._rpc.request(
            {{ route.method_member }},
{% if route.params_model is not none %}            params=params,
{% endif %}        )
{% endmacro %}

{% macro notification(event) %}{% if event.subscription %}{% set names = event.params | map(attribute="name") | map("identifier") | list %}{% set receiver = "_self" if "self" in names or event.accepts_extra_params else "self" %}    def {{ event.operation_name | identifier }}({{ param_signature(event, receiver) }}) -> RpcStream[{{ event.payload | annotation }}]:
{% if event.summary %}        """{{ event.summary | docstring }}"""
{% endif %}{{ params_body(event, names) }}        return {{ receiver }}._rpc.open_message_stream({{ event.rpc_name | constant }}{% if event.params_model is not none %}, params=params{% endif %})
{% else %}    def {{ event.operation_name | identifier }}(self) -> AsyncIterator[{{ event.payload | annotation }}]:
{% if event.summary %}        """{{ event.summary | docstring }}"""
{% endif %}        return self._rpc.subscribe({{ event.rpc_name | constant }})
{% endif %}{% endmacro %}

{% macro stream(item) %}{% set inline_signature = "    def " ~ (item.operation_name | identifier) ~ "(self) -> AbstractAsyncContextManager[" ~ (item | stream_connection) ~ "]:" %}{% if not item.call_variables and inline_signature | length <= 88 %}{{ inline_signature }}
{% else %}    def {{ item.operation_name | identifier }}(
        self,
{% if item.call_variables %}        *,
{% for variable in item.call_variables %}        {{ variable.name | identifier }}: {{ variable | variable_annotation }} | None = None,
{% endfor %}{% endif %}    ) -> AbstractAsyncContextManager[{{ item | stream_connection }}]:
{% endif %}{% if item.summary %}        """{{ item.summary | docstring }}"""
{% endif %}        return open_binary_stream(
            resolve_stream_endpoint(
                BINARY_STREAMS[BinaryStreamName.{{ item.name | constant }}],
                self._rpc.variables,
{% if item.call_variables %}                {
{% for variable in item.call_variables %}                    {{ variable.name | literal }}: {{ variable.name | identifier }},
{% endfor %}                },
{% endif %}            ),
            self._rpc.stream_opener,
            {{ item | stream_connection }},
        )
{% endmacro %}

{% macro socket_method(item) %}{% set binding = item | socket_binding %}{% set binding_module = "_socket_binding_" ~ binding.module if binding else "" %}{% set returns = binding_module ~ "." ~ binding.session if binding else item | socket_return_type %}{% set inline_signature = "    def " ~ (item.operation_name | identifier) ~ "(self) -> AbstractAsyncContextManager[" ~ returns ~ "]:" %}{% if not item.call_variables and inline_signature | length <= 88 %}{{ inline_signature }}
{% else %}    def {{ item.operation_name | identifier }}(
        self,
{% if item.call_variables %}        *,
{% for variable in item.call_variables %}        {{ variable.name | identifier }}: {{ variable | variable_annotation }} | None = None,
{% endfor %}{% endif %}{% if ("    ) -> AbstractAsyncContextManager[" ~ returns ~ "]:") | length > 88 %}    ) -> AbstractAsyncContextManager[
        {{ returns }}
    ]:
{% else %}    ) -> AbstractAsyncContextManager[{{ returns }}]:
{% endif %}
{% endif %}{% if item.summary %}        """{{ item.summary | docstring }}"""
{% endif %}{% if binding %}        return {{ binding_module }}.{{ binding.open }}(
            open_socket(
                resolve_socket_endpoint(
                    SOCKETS[SocketName.{{ item.name | constant }}],
                    self._rpc.variables,
{% if item.call_variables %}                    {
{% for variable in item.call_variables %}                        {{ variable.name | literal }}: {{ variable.name | identifier }},
{% endfor %}                    },
{% endif %}                ),
                self._rpc.socket_opener,
            )
        )
{% else %}        return open_socket(
            resolve_socket_endpoint(
                SOCKETS[SocketName.{{ item.name | constant }}],
                self._rpc.variables,
{% if item.call_variables %}                {
{% for variable in item.call_variables %}                    {{ variable.name | literal }}: {{ variable.name | identifier }},
{% endfor %}                },
{% endif %}            ),
            self._rpc.socket_opener,
        )
{% endif %}{% endmacro %}
