{% macro operation(route, root) %}{% if route.summary %}  /** {{ route.summary | comment }} */
{% endif %}{{ route | operation_signature }}
{{ route | operation_call(root) }}
  }
{% endmacro %}

{% macro notification(event, root) %}{% if event.summary %}  /** {{ event.summary | comment }} */
{% endif %}{% if event.subscription %}{{ event | message_signature }}
{{ event | message_call(root) }}
{% else %}  {{ event.operation_name | identifier }}(): AsyncIterable<{{ event.payload | type }}> {
{% if event | compact_notification(root) %}    return {{ "this.#rpc" }}.notifications(notifications.{{ event | route_key }});
{% else %}    return {{ "this.#rpc" }}.notifications(
      notifications.{{ event | route_key }},
    );
{% endif %}{% endif %}  }
{% endmacro %}

{% macro stream(item, root) %}{% set rpc = "this.#rpc" %}{% if item.summary %}  /** {{ item.summary | comment }} */
{% endif %}{{ item | stream_signature }}
    return {{ rpc }}.openStream(
{{ item | stream_endpoint(rpc) }}
      (transport) => new {{ item | stream_connection }}(transport),
    );
  }
{% endmacro %}

{% macro socket_method(item, root) %}{% set rpc = "this.#rpc" %}{% if item.summary %}  /** {{ item.summary | comment }} */
{% endif %}{{ item | socket_handle_signature }}
    return {{ rpc }}.openSocket(
{{ item | socket_handle_endpoint(rpc) }}
{{ item | socket_handle_connect }}
    );
  }
{% endmacro %}
