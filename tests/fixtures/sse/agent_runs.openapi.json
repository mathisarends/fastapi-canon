{
  "components": {
    "schemas": {
      "CanonInternalServerErrorEmbedded": {
        "additionalProperties": true,
        "description": "RFC 9457 Problem Details with a stable application code.",
        "properties": {
          "code": {
            "const": "internal_server_error",
            "pattern": "^[a-z][a-z0-9_]{2,}$",
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "format": "uri-reference",
            "type": "string"
          },
          "title": {
            "const": "Internal Server Error",
            "type": "string"
          },
          "type": {
            "const": "urn:fastapi-canon:problem/internal_server_error",
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InternalServerProblem": {
        "additionalProperties": true,
        "description": "RFC 9457 Problem Details with a stable application code.",
        "properties": {
          "code": {
            "const": "internal_server_error",
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "format": "uri-reference",
            "type": "string"
          },
          "status": {
            "const": 500,
            "type": "integer"
          },
          "title": {
            "const": "Internal Server Error",
            "type": "string"
          },
          "type": {
            "const": "urn:fastapi-canon:problem/internal_server_error",
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "InternalServerProblem",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": true,
        "description": "RFC 9457 Problem Details with a stable application code.",
        "properties": {
          "code": {
            "pattern": "^[a-z][a-z0-9_]{2,}$",
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "format": "uri-reference",
            "type": "string"
          },
          "status": {
            "maximum": 599,
            "minimum": 100,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "RequestValidationProblem": {
        "additionalProperties": true,
        "description": "RFC 9457 Problem Details with a stable application code.",
        "properties": {
          "code": {
            "const": "request_validation_error",
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                },
                "in": {
                  "enum": [
                    "path",
                    "query",
                    "header",
                    "cookie"
                  ],
                  "type": "string"
                },
                "parameter": {
                  "type": "string"
                },
                "pointer": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "detail"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "instance": {
            "format": "uri-reference",
            "type": "string"
          },
          "status": {
            "const": 422,
            "type": "integer"
          },
          "title": {
            "const": "Request validation failed",
            "type": "string"
          },
          "type": {
            "const": "urn:fastapi-canon:problem/request_validation_error",
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "errors"
        ],
        "title": "RequestValidationProblem",
        "type": "object"
      },
      "RunCompleted": {
        "properties": {
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "type": {
            "const": "run.completed",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "run_id"
        ],
        "title": "RunCompleted",
        "type": "object"
      },
      "RunEvent": {
        "discriminator": {
          "mapping": {
            "run.completed": "#/components/schemas/RunCompleted",
            "run.failed": "#/components/schemas/RunFailed",
            "run.started": "#/components/schemas/RunStarted",
            "token.delta": "#/components/schemas/TokenDelta"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/RunStarted"
          },
          {
            "$ref": "#/components/schemas/TokenDelta"
          },
          {
            "$ref": "#/components/schemas/RunCompleted"
          },
          {
            "$ref": "#/components/schemas/RunFailed"
          }
        ]
      },
      "RunFailed": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "const": "run.failed",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "message"
        ],
        "title": "RunFailed",
        "type": "object"
      },
      "RunRequest": {
        "properties": {
          "prompt": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          }
        },
        "required": [
          "prompt"
        ],
        "title": "RunRequest",
        "type": "object"
      },
      "RunStarted": {
        "properties": {
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "type": {
            "const": "run.started",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "run_id"
        ],
        "title": "RunStarted",
        "type": "object"
      },
      "TokenDelta": {
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          },
          "type": {
            "const": "token.delta",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "text"
        ],
        "title": "TokenDelta",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Agent runs",
    "version": "0.0.1"
  },
  "openapi": "3.2.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerProblem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/runs/{run_id}/events": {
      "get": {
        "operationId": "stream_run_events",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "delay",
            "required": false,
            "schema": {
              "default": 0.01,
              "maximum": 1,
              "minimum": 0,
              "title": "Delay",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "oneOf": [
                    {
                      "properties": {
                        "data": {
                          "contentMediaType": "application/json",
                          "contentSchema": {
                            "$ref": "#/components/schemas/RunEvent"
                          },
                          "type": "string"
                        },
                        "event": {
                          "not": {
                            "pattern": "^canon\\."
                          },
                          "type": "string"
                        },
                        "id": {
                          "type": "string"
                        },
                        "retry": {
                          "minimum": 0,
                          "type": "integer"
                        }
                      },
                      "required": [
                        "data"
                      ],
                      "type": "object"
                    },
                    {
                      "properties": {
                        "data": {
                          "contentMediaType": "application/json",
                          "contentSchema": {
                            "anyOf": [
                              {
                                "$ref": "#/components/schemas/CanonInternalServerErrorEmbedded"
                              }
                            ]
                          },
                          "type": "string"
                        },
                        "event": {
                          "const": "canon.problem",
                          "type": "string"
                        }
                      },
                      "required": [
                        "event",
                        "data"
                      ],
                      "type": "object"
                    },
                    {
                      "properties": {
                        "data": {
                          "contentMediaType": "application/json",
                          "contentSchema": {
                            "maxProperties": 0,
                            "type": "object"
                          },
                          "type": "string"
                        },
                        "event": {
                          "const": "canon.complete",
                          "type": "string"
                        }
                      },
                      "required": [
                        "event",
                        "data"
                      ],
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "Stream of JSON events"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationProblem"
                }
              }
            },
            "description": "Request validation failed"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerProblem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Stream Run Events",
        "tags": [
          "agentRuns"
        ],
        "x-canon-stream": {
          "businessItemSchema": {
            "properties": {
              "data": {
                "contentMediaType": "application/json",
                "contentSchema": {
                  "$ref": "#/components/schemas/RunEvent"
                },
                "type": "string"
              },
              "event": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "retry": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "data"
            ],
            "type": "object"
          },
          "completeEvent": "canon.complete",
          "problemEvent": "canon.problem",
          "problems": [],
          "version": 1
        }
      },
      "post": {
        "operationId": "stream_prompt",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "oneOf": [
                    {
                      "properties": {
                        "data": {
                          "contentMediaType": "application/json",
                          "contentSchema": {
                            "$ref": "#/components/schemas/RunEvent"
                          },
                          "type": "string"
                        },
                        "event": {
                          "not": {
                            "pattern": "^canon\\."
                          },
                          "type": "string"
                        },
                        "id": {
                          "type": "string"
                        },
                        "retry": {
                          "minimum": 0,
                          "type": "integer"
                        }
                      },
                      "required": [
                        "data"
                      ],
                      "type": "object"
                    },
                    {
                      "properties": {
                        "data": {
                          "contentMediaType": "application/json",
                          "contentSchema": {
                            "anyOf": [
                              {
                                "$ref": "#/components/schemas/CanonInternalServerErrorEmbedded"
                              }
                            ]
                          },
                          "type": "string"
                        },
                        "event": {
                          "const": "canon.problem",
                          "type": "string"
                        }
                      },
                      "required": [
                        "event",
                        "data"
                      ],
                      "type": "object"
                    },
                    {
                      "properties": {
                        "data": {
                          "contentMediaType": "application/json",
                          "contentSchema": {
                            "maxProperties": 0,
                            "type": "object"
                          },
                          "type": "string"
                        },
                        "event": {
                          "const": "canon.complete",
                          "type": "string"
                        }
                      },
                      "required": [
                        "event",
                        "data"
                      ],
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "Stream of JSON events"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationProblem"
                }
              }
            },
            "description": "Request validation failed"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerProblem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Stream Prompt",
        "tags": [
          "agentRuns"
        ],
        "x-canon-stream": {
          "businessItemSchema": {
            "properties": {
              "data": {
                "contentMediaType": "application/json",
                "contentSchema": {
                  "$ref": "#/components/schemas/RunEvent"
                },
                "type": "string"
              },
              "event": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "retry": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "data"
            ],
            "type": "object"
          },
          "completeEvent": "canon.complete",
          "problemEvent": "canon.problem",
          "problems": [],
          "version": 1
        }
      }
    }
  }
}
